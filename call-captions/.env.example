# Copy to .env and fill in. Never commit .env.

# Which speech-to-text service to use: mock (scripted demo), deepgram, or aws
CAPTION_PROVIDER=mock
CAPTION_LANGUAGE=en-US

# Where the caption server listens. Keep 127.0.0.1 when it runs on each agent's PC.
HOST=127.0.0.1
PORT=8787

# Optional shared secret. If set, agents open http://host:port/?token=THE_TOKEN
ACCESS_TOKEN=

# Deepgram (CAPTION_PROVIDER=deepgram)
DEEPGRAM_API_KEY=
# nova-3, or nova-3-medical for better accuracy on medical terms
DEEPGRAM_MODEL=nova-3

# Amazon Transcribe (CAPTION_PROVIDER=aws). Credentials come from the usual
# AWS sources: AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE, or an IAM role.
AWS_REGION=us-east-1
