{
  "manifest_version": 3,
  "name": "Ringy to Gmail",
  "version": "1.1.0",
  "description": "Press a shortcut on a Ringy lead to open a Gmail draft already addressed and filled in for that client.",
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    { "matches": ["https://mail.google.com/*"], "js": ["gmail.js"], "run_at": "document_idle" }
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Email this lead" },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Show the lead and pick a template"
    },
    "template-1": {
      "suggested_key": { "default": "Alt+Shift+1" },
      "description": "Email this lead with template 1"
    },
    "template-2": {
      "suggested_key": { "default": "Alt+Shift+2" },
      "description": "Email this lead with template 2"
    },
    "template-3": {
      "description": "Email this lead with template 3 (set a key in chrome://extensions/shortcuts)"
    }
  }
}
